<!DOCTYPE html>
<html>
<head><title>Stereo Render</title></head>
<body>
  <h1>Stereo Render (d={{ d }}, o={{ o }}, rx={{ rx }}&deg;, ry={{ ry }}&deg;, rz={{ rz }}&deg;)</h1>
  {% if exportedPaths %}
  <div style="background:#eef; border:1px solid #99c; padding:10px; margin-bottom:16px;">
    Saved to disk:<br>
    <code>{{ exportedPaths.leftPath }}</code><br>
    <code>{{ exportedPaths.rightPath }}</code>
  </div>
  {% endif %}
  {% for pair in pairs %}
  <h2>{{ pair.size }}x{{ pair.size }}</h2>
  <div style="display:flex; gap:20px; margin-bottom:24px;">
    <div><h3>Camera 1 (left)</h3><img src="{{ pair.img1 }}" width="{{ pair.size }}" height="{{ pair.size }}" style="image-rendering:pixelated; border:1px solid #ccc;"></div>
    <div><h3>Camera 2 (right)</h3><img src="{{ pair.img2 }}" width="{{ pair.size }}" height="{{ pair.size }}" style="image-rendering:pixelated; border:1px solid #ccc;"></div>
  </div>
  {% endfor %}
  <p><a href="/">Render another</a></p>
</body>
</html>
